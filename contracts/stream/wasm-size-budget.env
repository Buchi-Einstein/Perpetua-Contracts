# Reviewable size budget for the deployable fluxora-stream WASM artifact.
#
# Keep BUILD_COMMAND in sync with CI. Intentional growth should update this
# file in the same PR with a short explanation in the PR body.

PACKAGE=fluxora-stream
TARGET=wasm32v1-none
ARTIFACT=contracts/stream/target/wasm32v1-none/release/fluxora_stream.wasm
BUILD_COMMAND='(cd contracts/stream && cargo clean --target wasm32v1-none && cargo build --target wasm32v1-none --release)'

# Issue #117 target: sub-40 KiB. BASELINE is now the acceptance ceiling rather
# than the historical ~47 KiB measurement; CI prints the exact measured bytes
# on every run so reviewers can update it after an intentional clean rebuild.
# `lto="fat"` + `opt-level="z"` + `strip="symbols"` are wired in Cargo.toml to
# reach this without feature regression.
BASELINE_BYTES=40960

# Soroban caps a contract code entry at 128 KiB.
MAX_BYTES=131072

